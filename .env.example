# Copy this file to ".env" (same folder) and edit the values.
# The app also runs WITHOUT a .env file (demo mode).

PORT=5000

# Local MongoDB (install MongoDB Community Server) or a free MongoDB Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017/travelmate

# Any long random string
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional - free key from https://openweathermap.org/api (leave empty for demo weather)
OPENWEATHER_API_KEY=

# Optional - only needed if you host frontend and backend on different domains
CLIENT_URL=http://localhost:5173
